# Local dummy mode does not require credentials. Never commit real values.
LINE_AUTH_MODE=dummy
LINE_CHANNEL_ACCESS_TOKEN=replace-me
LINE_CHANNEL_SECRET=replace-me
LIFF_ID=replace-me
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Required when running without Supabase, so upload receipts survive invocations.
UPLOAD_SIGNING_KEY=replace-me
